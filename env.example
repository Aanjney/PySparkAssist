# Copy to .env and edit.
#
# Deployment (see README):
#   - Ingest on the host (uv --extra ml --extra ingest)
#   - Qdrant + API via docker run (network pysparkassist)
#   - Caddy in wee-deployment-scripts compose → host.docker.internal:8000

# --- Required ---
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Qdrant ---
# Host ingest / evals: Qdrant published to localhost
QDRANT_URL=http://localhost:6333
# API container (override at docker run): QDRANT_URL=http://qdrant:6333

# --- Paths (SQLITE_PATH, GROQ_LIMITS_PATH, RAW_DATA_PATH derive from DATA_DIR) ---
DATA_DIR=./data
# SQLITE_PATH=./data/graph.db
# GROQ_LIMITS_PATH=./data/groq_limits.json
# RAW_DATA_PATH=./data/raw

# --- Optional (omit to use defaults in config.py) ---
# GROQ_TEMPERATURE=0.3
# GROQ_MAX_TOKENS=2048
# RATE_LIMIT_RPM=20
# RELEVANCE_THRESHOLD=0.35
# OFF_TOPIC_SCORE_THRESHOLD=0.55
# RETRIEVAL_MODE=dense_entity_boost
# GROQ_LIMITS_STARTUP_PROBE=true
